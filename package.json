{
  "name": "rave-private",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts apps/web",
    "start": "node dist/apps/api/src/main.js",
    "worker": "tsx apps/worker/src/main.ts",
    "build": "tsc -p tsconfig.server.json && vite build --config apps/web/vite.config.ts apps/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts tests *.config.ts",
    "format": "prettier --write apps packages scripts tests infra docs package.json pnpm-workspace.yaml *.config.* tsconfig*.json",
    "format:check": "prettier --check apps packages scripts tests infra docs package.json pnpm-workspace.yaml *.config.* tsconfig*.json",
    "env:check": "tsx scripts/env-check.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "bootstrap": "tsx apps/api/src/bootstrap.ts",
    "local:prepare": "tsx scripts/local-prepare.ts",
    "local:db": "tsx scripts/local-db.ts",
    "fixtures:generate": "tsx packages/test-fixtures/src/generate.ts",
    "test:unit": "vitest run --coverage",
    "test:i18n": "vitest run tests/unit/i18n.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:e2e": "playwright test",
    "test:providers:contract": "vitest run --config vitest.providers.config.ts",
    "test:providers:live": "tsx tests/providers/live.ts",
    "test:soak": "playwright test --config playwright.soak.config.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:unit && pnpm test:integration && pnpm test:security && pnpm test:providers:contract && pnpm test:e2e",
    "verify:release": "pnpm verify && pnpm test:soak",
    "backup": "tsx scripts/backup.ts",
    "restore:verify": "tsx scripts/restore-verify.ts",
    "recover": "tsx scripts/recover.ts",
    "test:prepare": "tsx scripts/test-prepare.ts && pnpm fixtures:generate && tsx scripts/seed-fixtures.ts",
    "security:scan": "tsx scripts/secret-scan.ts",
    "test:deployment": "tsx scripts/docker-verify.ts",
    "benchmark:upload": "tsx scripts/benchmark-upload.ts",
    "openapi": "tsx scripts/openapi.ts",
    "rotate:key": "tsx scripts/key-rotation.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.104.0",
    "argon2": "0.45.1",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.5",
    "google-auth-library": "11.1.0",
    "googleapis": "182.0.0",
    "hls-parser": "0.16.1",
    "ipaddr.js": "2.5.0",
    "mp4box": "2.4.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "shaka-player": "5.2.12",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
